{
  "name": "spineworkspace-marketing",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsx scripts/generate-rss.ts && tsx scripts/generate-llms-txt.ts && tsx scripts/generate-responsive-screenshots.ts && next build --webpack",
    "dev": "next dev -p 5010 -H 0.0.0.0",
    "lint": "node scripts/check-release-preflight.mjs",
    "start": "wrangler dev --env prod",
    "wrangler:login": "env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID wrangler login",
    "wrangler:whoami": "env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_ACCOUNT_ID wrangler whoami",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:test": "wrangler deploy --env test",
    "deploy:prod": "wrangler deploy --env prod",
    "preview": "wrangler dev --env prod",
    "content:migrate": "tsx scripts/migrate-blog-to-sanity.ts",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run audit:site && npm run check:cloudflare && npm run typecheck",
    "audit:site": "node scripts/audit-corporate-site.mjs",
    "check:cloudflare": "node scripts/check-cloudflare-config.mjs",
    "verify:artifact": "node scripts/verify-static-artifact.mjs && node scripts/verify-corporate-coverage.mjs",
    "verify:live": "node scripts/verify-live-site.mjs",
    "build:cloudflare": "npm run lint && npm run audit:site && npm run check:cloudflare && npm run typecheck && npm run build && npm run verify:artifact",
    "deploy:cloudflare": "npm run verify:artifact && wrangler deploy --env prod && node scripts/purge-cloudflare-cache.mjs && npm run verify:live"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.31.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.12.0",
    "framer-motion": "^11.18.0",
    "lucide-react": "^0.454.0",
    "next": "16.0.10",
    "next-sanity": "^13.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^5.31.2",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  }
}
