# Build-time public origin (canonical URLs, sitemap, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=https://spineinnovtech.com
# PUBLIC_SITE_URL is also accepted (same meaning)

# Content (Sanity) — fetched at build time for static export
CONTENT_PROVIDER=sanity
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Migration / Studio deploy only (never commit)
# SANITY_API_WRITE_TOKEN=
# SANITY_STUDIO_PROJECT_ID=  # optional alias for Studio CLI
